# NEUTRON Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# SYSTEM MODE
# =============================================================================
# NORMAL = Fast path, layers 1-2 only, <1GB RAM, <2s latency
# EXTREME = Full reasoning, layers 1-7, up to 2.5GB RAM
NEUTRON_MODE=NORMAL

# Debug mode (enables verbose logging)
NEUTRON_DEBUG=false

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================
# Gemini API Key (for emotional, personal, reflective queries)
GEMINI_API_KEY=your_gemini_api_key_here

# Perplexity API Key (for news, facts, search-style queries)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# =============================================================================
# AI ROUTER CONFIGURATION
# =============================================================================
# Default provider when intent is unclear (gemini|perplexity|offline)
AI_DEFAULT_PROVIDER=gemini

# Enable response caching (reduces API calls)
AI_CACHE_ENABLED=true

# Cache TTL in seconds (default: 1 hour)
AI_CACHE_TTL_SECONDS=3600

# Max cache size in MB
AI_CACHE_MAX_SIZE_MB=100

# Rate limiting (requests per minute per provider)
AI_RATE_LIMIT_GEMINI=60
AI_RATE_LIMIT_PERPLEXITY=30

# =============================================================================
# OLLAMA (Local LLM)
# =============================================================================
# Enable Ollama for local inference (requires Ollama running)
OLLAMA_ENABLED=false

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (tinyllama:1.1b is recommended for low RAM)
OLLAMA_MODEL=tinyllama:1.1b

# Use Ollama for local system monitoring queries
OLLAMA_FOR_MONITORING=true

# Use Ollama for emotion analysis (privacy-preserving)
OLLAMA_FOR_EMOTIONS=true

# =============================================================================
# VOICE PIPELINE
# =============================================================================
# Wake word engine (openwakeword|porcupine)
WAKEWORD_ENGINE=openwakeword

# Wake word sensitivity (0.0-1.0, higher = more sensitive)
WAKEWORD_SENSITIVITY=0.5

# Custom wake words (comma-separated)
WAKEWORD_PHRASES=neutron,hey neutron

# STT engine (vosk)
STT_ENGINE=vosk

# Vosk model path (small model for Pi)
VOSK_MODEL_PATH=./models/vosk-model-small-en-us-0.15

# TTS engine (piper)
TTS_ENGINE=piper

# Piper voice model
PIPER_VOICE=en_US-lessac-medium

# Piper model path
PIPER_MODEL_PATH=./models/piper

# Audio input device index (leave empty for default)
AUDIO_INPUT_DEVICE=

# Audio output device index (leave empty for default)
AUDIO_OUTPUT_DEVICE=

# Enable barge-in (user can interrupt TTS)
BARGE_IN_ENABLED=true

# =============================================================================
# MEMORY SYSTEM
# =============================================================================
# SQLite database path
SQLITE_DATABASE_PATH=./data/neutron.db

# Embeddings model (use small model for Pi)
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# ChromaDB path for vector storage
CHROMA_PERSIST_PATH=./data/chroma

# Max episodic memories to keep locally
MAX_EPISODIC_MEMORIES=10000

# Memory consolidation interval (hours)
MEMORY_CONSOLIDATION_INTERVAL_HOURS=24

# =============================================================================
# CLOUD SYNC (Optional)
# =============================================================================
# Enable cloud sync (requires GCS credentials)
CLOUD_SYNC_ENABLED=false

# Google Cloud Storage bucket name
GCS_BUCKET_NAME=neutron-memory-backup

# Path to GCS service account key JSON
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcs-credentials.json

# Sync interval (hours)
CLOUD_SYNC_INTERVAL_HOURS=24

# =============================================================================
# EMOTION SYSTEM
# =============================================================================
# Emotion decay rate (per second, toward neutral)
EMOTION_DECAY_RATE=0.01

# Neutral emotion values
EMOTION_NEUTRAL_VALENCE=0.5
EMOTION_NEUTRAL_AROUSAL=0.3
EMOTION_NEUTRAL_TRUST=0.6
EMOTION_NEUTRAL_FATIGUE=0.2
EMOTION_NEUTRAL_CONFIDENCE=0.7

# =============================================================================
# MOTIVATION SYSTEM (Layer 5)
# =============================================================================
# Initiative cooldown (seconds between proactive interactions)
INITIATIVE_COOLDOWN_SECONDS=300

# Quiet hours (24h format, e.g., "22:00-07:00")
QUIET_HOURS=22:00-07:00

# Annoyance threshold (0.0-1.0, higher = more tolerant)
ANNOYANCE_THRESHOLD=0.7

# =============================================================================
# SOCIAL CORTEX (Layer 6)
# =============================================================================
# Interrupt confidence threshold (only interrupt if >0.7)
INTERRUPT_CONFIDENCE_THRESHOLD=0.7

# Conversation observation window (seconds)
CONVERSATION_WINDOW_SECONDS=30

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# FastAPI server host
SERVER_HOST=0.0.0.0

# FastAPI server port
SERVER_PORT=8000

# WebSocket path
WEBSOCKET_PATH=/ws

# CORS origins (comma-separated, use * for development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# GUI CONFIGURATION
# =============================================================================
# GUI WebSocket URL (backend address)
GUI_WEBSOCKET_URL=ws://localhost:8000/ws

# Eye animation FPS
EYE_ANIMATION_FPS=30

# Boot retry interval (ms)
BOOT_RETRY_INTERVAL_MS=1000

# Max boot retries before showing error
BOOT_MAX_RETRIES=30

# =============================================================================
# HARDWARE (Optional - for future expansion)
# =============================================================================
# Enable hardware integration
HARDWARE_ENABLED=false

# Servo controller (pca9685|pigpio)
SERVO_CONTROLLER=pca9685

# I2C address for PCA9685
PCA9685_I2C_ADDRESS=0x40

# GPIO pin for status LED
STATUS_LED_PIN=17

# GPIO pin for mute button
MUTE_BUTTON_PIN=27

# =============================================================================
# LOGGING
# =============================================================================
# Log level (DEBUG|INFO|WARNING|ERROR|CRITICAL)
LOG_LEVEL=INFO

# Log format (json|console)
LOG_FORMAT=console

# Log file path (leave empty to disable file logging)
LOG_FILE_PATH=./logs/neutron.log

# Log rotation (bytes)
LOG_MAX_BYTES=10485760

# Log backup count
LOG_BACKUP_COUNT=5

# =============================================================================
# PERSONALITY
# =============================================================================
# Personality style (genz|formal|friendly)
PERSONALITY_STYLE=genz

# Response max tokens
RESPONSE_MAX_TOKENS=150

# Temperature for response generation
RESPONSE_TEMPERATURE=0.7
